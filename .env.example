# =============================================================================
# Security Operation Center (SOC) - Configuration de l'environnement
# =============================================================================
# Copiez ce fichier sous le nom .env :
#   cp .env.example .env
#   chmod 600 .env
#
# IMPORTANT : Définissez un mot de passe fort et unique avant le premier démarrage.
# Règles requises par OpenSearch Security :
# - Au moins 8 caractères (12+ recommandés en production)
# - Au moins une lettre majuscule [A-Z]
# - Au moins une lettre minuscule [a-z]
# - Au moins un chiffre [0-9]
# - Au moins un caractère spécial (ex: !@#$%^&*()_+)
# - Ne pas utiliser d'espaces autour du "=" ni de guillemets.
# =============================================================================

# Mot de passe administrateur OpenSearch (OBLIGATOIRE au premier démarrage)
# Remplacez la valeur ci-dessous par votre mot de passe robuste généré :
# Exemple de génération : openssl rand -base64 16 | tr -dc 'A-Za-z0-9!#%&*' | head -c 16
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# Mot de passe du compte de service « vector » (écriture dans soc-* uniquement)
# et du compte « analyste » (lecture seule, pour consulter le SOC au quotidien).
# Mêmes règles de robustesse que ci-dessus. Créés/mis à jour par scripts/setup.sh.
VECTOR_PASSWORD=
ANALYST_PASSWORD=

# Notifications d'alertes (facultatif). URL d'un webhook :
# - Slack : https://hooks.slack.com/services/...
# - ntfy (notification sur téléphone) : https://ntfy.sh/un-sujet-difficile-a-deviner
# - tout service acceptant un POST avec le message en texte brut
SOC_WEBHOOK_URL=

# Ports d'écoute du pot de miel (faux services exposés aux attaquants)
HONEYPOT_HTTP_PORT=8080
HONEYPOT_SSH_PORT=2222
HONEYPOT_TELNET_PORT=2323

# Fuseau horaire pour l'interprétation des logs syslog RFC 3164 (sans offset UTC)
SOC_TIMEZONE=Europe/Paris

# Rétention des index OpenSearch soc-* en jours (défaut : 30 jours)
RETENTION_DAYS=30

# Options de la machine virtuelle Java OpenSearch (Heap size)
# Recommandation : allouer 50% de la RAM disponible (ex: -Xms1g -Xmx1g pour 2 Go)
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"

# URL de connexion au cluster OpenSearch (utilisée par scripts/setup.sh et scripts/verify.sh)
OS_URL=https://localhost:9200

# URL de connexion à OpenSearch Dashboards
OSD_URL=http://localhost:5601

# Hôte et port d'écoute Syslog pour les simulations et sondes (scripts/simulate-attack.sh)
SYSLOG_HOST=localhost
SYSLOG_PORT=9000
