# Copiez ce fichier en .env puis choisissez un mot de passe robuste :
# 8 caractères minimum, avec majuscule, minuscule, chiffre et caractère spécial.
# Pas d'espaces autour du "=" ni de guillemets.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangezMoi-2026!

# Fuseau horaire des machines qui envoient du syslog RFC 3164 (heure locale sans fuseau)
SOC_TIMEZONE=Europe/Paris
